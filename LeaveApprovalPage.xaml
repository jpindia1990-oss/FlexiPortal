<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlexiPortal.Mobile.Pages.LeaveApprovalPage"
             Title="Leave Approvals"
             BackgroundColor="#F5F7FB">

    <Grid RowDefinitions="Auto,Auto,*" Padding="15" RowSpacing="10">

        <!-- Header -->
        <StackLayout Grid.Row="0" Orientation="Horizontal">
            <Label Text="Team Requests" FontSize="20" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center" HorizontalOptions="StartAndExpand"/>
            <Button Text="Refresh" FontSize="12" HeightRequest="32" CornerRadius="16" BackgroundColor="White" TextColor="Black" BorderColor="#DDD" BorderWidth="1" Clicked="OnRefreshClicked"/>
        </StackLayout>

        <!-- TABS - This was missing -->
        <HorizontalStackLayout Grid.Row="1" Spacing="10">
            <Button x:Name="BtnPending" Text="Pending" BackgroundColor="#0A84FF" TextColor="White" CornerRadius="20" HeightRequest="36" Clicked="OnPendingTab"/>
            <Button x:Name="BtnHistory" Text="History - Last 100" BackgroundColor="White" TextColor="Black" CornerRadius="20" HeightRequest="36" BorderColor="#DDD" BorderWidth="1" Clicked="OnHistoryTab"/>
        </HorizontalStackLayout>

        <!-- Lists -->
        <Grid Grid.Row="2">
            <Label x:Name="NoDataLabel" Text="No pending requests" IsVisible="False"
                   HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" FontSize="16"/>

            <CollectionView x:Name="ApprovalList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="14" Padding="14" Margin="0,6" HasShadow="False" BackgroundColor="White" BorderColor="#E9ECF2">
                            <StackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding E_Name}" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                                    <Frame Grid.Column="1" Padding="8,3" CornerRadius="8" BackgroundColor="#EEF4FF" BorderColor="Transparent" HasShadow="False">
                                        <Label Text="{Binding Lv_type}" FontSize="12" FontAttributes="Bold" TextColor="#0A84FF"/>
                                    </Frame>
                                </Grid>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Fr_date}" FontSize="13" TextColor="#333" FontAttributes="Bold"/>
                                    <Label Text="→" FontSize="13" TextColor="Gray"/>
                                    <Label Text="{Binding To_date}" FontSize="13" TextColor="#333" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Lv_reason}" FontSize="13" TextColor="#555" MaxLines="2" LineBreakMode="TailTruncation"/>
                                <BoxView HeightRequest="1" Color="#F0F2F6" Margin="0,4"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Grid.Column="0" Text="Reject" BackgroundColor="#FFF0F0" TextColor="#D92D20" CornerRadius="10" FontAttributes="Bold"
                                            CommandParameter="{Binding Tran_Id}" Clicked="OnRejectClicked"/>
                                    <Button Grid.Column="1" Text="Approve" BackgroundColor="#0A84FF" TextColor="White" CornerRadius="10" FontAttributes="Bold"
                                            CommandParameter="{Binding Tran_Id}" Clicked="OnApproveClicked"/>
                                </Grid>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView x:Name="HistoryList" IsVisible="False" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,6" Padding="12" CornerRadius="12" BackgroundColor="White" BorderColor="#E9ECF2" HasShadow="False">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding E_Name}" FontAttributes="Bold" TextColor="Black"/>
                                    <Label Grid.Column="1" Text="{Binding lv_stat}" FontSize="12" FontAttributes="Bold" TextColor="Blue"/>
                                </Grid>
                                <Label FontSize="13" TextColor="#333">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Lv_type}" FontAttributes="Bold"/>
                                            <Span Text=" - "/>
                                            <Span Text="{Binding Fr_date}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
      <ActivityIndicator x:Name="Loading" Grid.Row="2" IsVisible="False" IsRunning="True" Color="#0A84FF" VerticalOptions="Center" HorizontalOptions="Center" HeightRequest="50" WidthRequest="50"/>
    </Grid>
</ContentPage>