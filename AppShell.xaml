<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FlexiPortal.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:FlexiPortal.Mobile.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="FlexiPortal">

    <FlyoutItem Title="Dashboard" Icon="home.png">
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate pages:MainPage}" Route="MainPage"/>
    </FlyoutItem>

    <!-- Give x:Name to control visibility -->
    <FlyoutItem x:Name="PunchFlyout" Title="Punch" Icon="punch.png">
        <ShellContent Title="Punch" ContentTemplate="{DataTemplate pages:AttendancePage}" Route="AttendancePage"/>
    </FlyoutItem>

    <FlyoutItem Title="Attendance History" Icon="history.png">
        <ShellContent Title="Attendance" ContentTemplate="{DataTemplate pages:AttendanceHistoryPage}" Route="AttendanceHistoryPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Payroll" Icon="payroll.png">
        <ShellContent Title="Payroll" ContentTemplate="{DataTemplate pages:PayrollPage}" Route="PayrollPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Leave" Icon="leave.png">
        <ShellContent Title="Leave" ContentTemplate="{DataTemplate pages:LeaveBalancePage}" Route="LeaveBalancePage"/>
    </FlyoutItem>
           
        <FlyoutItem Title="Leave Approvals" Icon="leave.png">
            <ShellContent Title="Leave Approvals" ContentTemplate="{DataTemplate pages:LeaveApprovalPage}" Route="LeaveApprovalPage"/>
        </FlyoutItem>
    
   

</Shell>