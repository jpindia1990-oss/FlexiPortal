<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlexiPortal.Mobile.Pages.MainPage"
             BackgroundColor="#f8fafc">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <HorizontalStackLayout Spacing="10" Margin="0,10,0,10">
                <Frame WidthRequest="40" HeightRequest="40" CornerRadius="12" BackgroundColor="#2563eb" Padding="0" BorderColor="Transparent" HasShadow="False">
                    <Label x:Name="InitialLabel" Text="F" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <VerticalStackLayout>
                    <Label x:Name="EmployeeNameLabel" Text="Welcome" FontSize="18" FontAttributes="Bold" TextColor="#0f172a"/>
                    <Label x:Name="EmployeeIdLabel" Text="ID: --" FontSize="11" TextColor="#64748b"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Label x:Name="PunchStatusLabelTop" Text="Not Punched Today" FontSize="12" TextColor="#64748b" Margin="0,0,0,5"/>

            <!-- SINGLE STATUS LABEL - Approved / Pending / Not Approved -->
            <Border x:Name="StatusBorder" Stroke="#E2E8F0" StrokeThickness="1" Background="#FFFFFF" Padding="12" IsVisible="True">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="DeviceInfoLabel" Text="Device: ..." FontSize="10" TextColor="#64748b"/>
                    <Label x:Name="ApprovalStatusLabel" Text="Checking status..." FontSize="13" FontAttributes="Bold" TextColor="#0f172a"/>
                </VerticalStackLayout>
            </Border>

            
            <Border x:Name="DeviceApprovalCard" IsVisible="False" StrokeThickness="0" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 16" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*" Padding="16,16,16,8">
                        <Border BackgroundColor="#F59E0B" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                            <Label Text="⚠" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                            <Label Text="Device Approval Required" FontAttributes="Bold" FontSize="14" TextColor="#92400E"/>
                            <Label Text="GPS tracking is enabled. Request approval to punch." FontSize="11" TextColor="#78350F" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#FDE68A" Margin="16,0"/>
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Button x:Name="RequestApprovalBtn" Text="Request Device Approval" BackgroundColor="#F59E0B" TextColor="White" CornerRadius="10" HeightRequest="44" FontSize="13" FontAttributes="Bold" Clicked="OnRequestApprovalClicked"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid x:Name="MenuGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Frame x:Name="PunchCard" Grid.Row="0" Grid.Column="0" CornerRadius="16" BackgroundColor="White" Padding="16" HasShadow="True" BorderColor="#e2e8f0">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPunchPageClicked"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="👆" FontSize="20"/>
                        <Label Text="Punch" FontSize="14" FontAttributes="Bold" TextColor="#0f172a"/>
                        <Label Text="In / Out" FontSize="10" TextColor="#64748b"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame x:Name="AttendanceFrame" Grid.Row="0" Grid.Column="1" CornerRadius="16" BackgroundColor="White" Padding="16" HasShadow="True" BorderColor="#e2e8f0">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAttendancePageClicked"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="📊" FontSize="20"/>
                        <Label Text="Attendance" FontSize="14" FontAttributes="Bold" TextColor="#0f172a"/>
                        <Label x:Name="AttendanceSubText" Text="History Details" FontSize="10" TextColor="#64748b"/>
                    </VerticalStackLayout>
                </Frame>
                <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="16" Stroke="#e2e8f0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Radius="10" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPayslipPageClicked"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="💰" FontSize="20"/>
                        <Label Text="Payroll" FontSize="14" FontAttributes="Bold" TextColor="#0f172a"/>
                        <Label Text="Payslip Download" FontSize="10" TextColor="#64748b"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="16" Stroke="#e2e8f0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Radius="10" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLeavePageClicked"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🌿" FontSize="16"/>
                        <Label Text="Leaves" FontSize="14" FontAttributes="Bold" TextColor="#0f172a"/>
                        <Label Text="Apply / Status" FontSize="10" TextColor="#64748b"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>
            <!-- ===== CALENDAR + HOLIDAYS ===== -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10">

                <!-- MINI CALENDAR -->
                <Border Grid.Column="0" BackgroundColor="White" Stroke="#e5e7eb" StrokeThickness="1" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📅 Calendar" FontAttributes="Bold" TextColor="Black"/>
                        <!-- Month Year -->
                        <Label x:Name="MonthYearLabel" Text="Aug 2026" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                        <!-- Week Days -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" >
                            <Label Grid.Column="0" Text="S" FontSize="10" HorizontalOptions="Center" TextColor="Red"/>
                            <Label Grid.Column="1" Text="M" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                            <Label Grid.Column="2" Text="T" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                            <Label Grid.Column="3" Text="W" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                            <Label Grid.Column="4" Text="T" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                            <Label Grid.Column="5" Text="F" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                            <Label Grid.Column="6" Text="S" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                        </Grid>
                        <!-- Calendar Dates -->
                        <CollectionView x:Name="CalendarView" HeightRequest="140">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="7" VerticalItemSpacing="4" HorizontalItemSpacing="2"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{Binding Bg}" Padding="2" HeightRequest="28" WidthRequest="28">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Day}" FontSize="11" TextColor="{Binding Color}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                       
                    </VerticalStackLayout>
                </Border>

                <!-- UPCOMING HOLIDAYS -->
                <Border Grid.Column="1" BackgroundColor="White" Stroke="#e5e7eb" StrokeThickness="1" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="🎉" FontSize="14"/>
                            <Label Text="Upcoming Holidays" FontAttributes="Bold" FontSize="13" TextColor="Black"/>
                        </HorizontalStackLayout>

                        <CollectionView x:Name="HolidayCollection" HeightRequest="170">
                            <CollectionView.EmptyView>
                                <Label Text="No holidays" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="10">
                                        <Border BackgroundColor="#fee2e2" Padding="6" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                                <Label Text="{Binding Day}" FontSize="12" FontAttributes="Bold" TextColor="#dc2626" HorizontalOptions="Center"/>
                                                <Label Text="{Binding Month}" FontSize="9" TextColor="#dc2626" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="11" FontAttributes="Bold" TextColor="Black" MaxLines="1"/>
                                            <Label Text="{Binding DateString}" FontSize="10" TextColor="Gray"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="#F59E0B" VerticalOptions="Center" HeightRequest="30"/>
            <Button Text="Change Password" Clicked="OnChangePasswordClicked" BackgroundColor="#dbeafe" TextColor="#2563eb" CornerRadius="12" HeightRequest="44" Margin="0,10,0,0"/>
            <Button Text="Logout" Clicked="OnLogoutClicked" BackgroundColor="#fee2e2" TextColor="#dc2626" CornerRadius="12" HeightRequest="44" Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>